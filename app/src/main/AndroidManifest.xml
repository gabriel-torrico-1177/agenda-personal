<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- screenOrientation="portrait" en cada pantalla: la app se usa siempre en vertical,
         así no se pierden los datos elegidos en un formulario al girar el teléfono -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AgendaPersonal">
        <!-- Inicio (P1) -->
        <activity
            android:name=".vista.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Calendario de la semana (P2) -->
        <activity
            android:name=".vista.CalendarioActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <!-- Formulario de sesión (P3) -->
        <activity
            android:name=".vista.SesionFormActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <!-- Lista de materias (P4) -->
        <activity
            android:name=".vista.MateriasActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <!-- Formulario de materia (P5) -->
        <activity
            android:name=".vista.MateriaFormActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <!-- Reporte semanal (P7) -->
        <activity
            android:name=".vista.ReporteActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <!-- Meta semanal (P8) -->
        <activity
            android:name=".vista.MetaActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <!-- Lista de contactos (P9) -->
        <activity
            android:name=".vista.ContactosActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <!-- Formulario de contacto (P10): solo se abre desde la propia app -->
        <activity
            android:name=".vista.ContactoFormActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>