<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AgendaPersonal">
        <activity
            android:name=".vista.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Lista de contactos (P2) -->
        <activity
            android:name=".vista.ContactosActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- Formulario de contacto (P3): solo se abre desde la propia app -->
        <activity
            android:name=".vista.ContactoFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- Lista de materias (P4) -->
        <activity
            android:name=".vista.MateriasActivity"
            android:exported="false" />
        <!-- Formulario de sesión (P3) -->
        <activity
            android:name=".vista.SesionFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- Formulario de materia (P5) -->
        <activity
            android:name=".vista.MateriaFormActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>