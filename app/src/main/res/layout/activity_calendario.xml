<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla P2: calendario de la semana con las sesiones del día elegido -->
<!-- Raíz vertical: arriba el contenido (FrameLayout) y abajo el menú inferior -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".vista.CalendarioActivity">

    <!-- FrameLayout: permite poner el botón + flotando encima de la lista.
         height 0dp + weight 1: ocupa todo el alto que deja libre el menú -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Encabezado: título, ◀ mes ▶ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/titulo_calendario"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnAnterior"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/semana_anterior"
                    android:minWidth="48dp"
                    android:padding="0dp"
                    android:text="@string/flecha_anterior" />

                <TextView
                    android:id="@+id/tvMes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSiguiente"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/semana_siguiente"
                    android:minWidth="48dp"
                    android:padding="0dp"
                    android:text="@string/flecha_siguiente" />
            </LinearLayout>

            <!-- Tira de los 7 días: está vacía, CalendarioActivity le agrega los días con item_dia.xml -->
            <LinearLayout
                android:id="@+id/llDias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="8dp" />

            <!-- Día elegido, por ejemplo "Viernes 13/11/2026" -->
            <TextView
                android:id="@+id/tvDiaElegido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Sesiones del día elegido (las llena SesionAdapter) -->
            <ListView
                android:id="@+id/lvSesiones"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="88dp" />

            <!-- Mensaje cuando el día no tiene sesiones (el ListView lo muestra solo) -->
            <TextView
                android:id="@+id/tvVacio"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/lista_sesiones_vacia"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Botón + para planificar una sesión -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAgregar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:contentDescription="@string/btn_agregar_sesion"
            android:src="@android:drawable/ic_input_add" />
    </FrameLayout>

    <!-- Menú inferior: pega aquí el contenido de menu_inferior.xml -->
    <include layout="@layout/menu_inferior" />
</LinearLayout>
