<?xml version="1.0" encoding="utf-8"?>
<!-- Diseño de UNA fila de la lista de materias: una tarjeta con círculo de color, nombre, docente y botón eliminar (papelera) -->
<!-- Raíz con padding: el ListView ignora los márgenes de la raíz de cada fila, por eso el espacio
     alrededor de la tarjeta se hace con padding (16dp a los costados y 4dp + 4dp = 8dp entre tarjetas) -->
<!-- blocksDescendants: el botón eliminar no "roba" el foco, así tocar la fila sigue abriendo la edición -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="blocksDescendants"
    android:paddingHorizontal="16dp"
    android:paddingVertical="4dp">

    <!-- Tarjeta: fondo gris oscuro con borde y esquinas de 12dp (fondo_tarjeta.xml, igual que en Inicio).
         foreground: el efecto al tocar se dibuja solo sobre la tarjeta -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fondo_tarjeta"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingVertical="10dp"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <!-- Círculo de color de 40dp con la inicial de la materia en blanco (@color/texto) y en negrita.
             El adaptador le pone la forma redonda, el color de la materia y la letra -->
        <TextView
            android:id="@+id/vColor"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="14dp"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="@color/texto"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Nombre en negrita y docente debajo; ocupa todo el ancho que sobra -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Docente: ícono de persona pequeño (16dp, gris) y el nombre del docente.
                 Si no hay docente, el adaptador oculta el ícono y escribe "Sin docente" en cursiva -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- tint: pinta de gris el ícono ic_persona (que es verde) -->
                <ImageView
                    android:id="@+id/ivDocente"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_persona"
                    android:tint="@color/texto_secundario" />

                <TextView
                    android:id="@+id/tvDocente"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/texto_secundario"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Botón eliminar: papelera de 22dp (ic_eliminar.xml) centrada en 48dp, sin agrandarse (scaleType center) -->
        <ImageButton
            android:id="@+id/btnEliminar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_eliminar_materia"
            android:scaleType="center"
            android:src="@drawable/ic_eliminar" />
    </LinearLayout>
</FrameLayout>
