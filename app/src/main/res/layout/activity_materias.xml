<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla P4: lista de materias -->
<!-- Raíz vertical: arriba el contenido (FrameLayout) y abajo el menú inferior -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".vista.MateriasActivity">

    <!-- FrameLayout: permite poner el botón + flotando encima de la lista.
         height 0dp + weight 1: ocupa todo el alto que deja libre el menú -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Título con la flecha ← a la izquierda (boton_volver.xml).
                 gravity top + título de 48dp de alto: la flecha (48dp) queda a la altura del título
                 y el contador va debajo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <include layout="@layout/boton_volver" />

                <!-- Título y, debajo, el contador "5 materias" (lo llena MateriasActivity) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:text="@string/titulo_materias"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvContador"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/texto_secundario"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Lista de materias (la llena MateriaAdapter).
                 Sin líneas divisorias (cada fila ya es una tarjeta) y sin el resaltado gris de toda la fila
                 (el efecto al tocar lo dibuja la tarjeta). paddingTop: un poco de aire arriba;
                 paddingBottom 88dp: la última tarjeta no queda tapada por el botón + -->
            <ListView
                android:id="@+id/lvMaterias"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp"
                android:listSelector="@android:color/transparent"
                android:paddingTop="4dp"
                android:paddingBottom="88dp" />

            <!-- Lista vacía (el ListView la muestra sola con setEmptyView): ícono grande de libro,
                 el mensaje "Aún no tienes materias" y la pista de qué hacer, todo centrado -->
            <LinearLayout
                android:id="@+id/llVacio"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <!-- tint: pinta de gris (texto_pista) el ícono ic_libro, que es verde -->
                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginBottom="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_libro"
                    android:tint="@color/texto_pista" />

                <TextView
                    android:id="@+id/tvVacio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/lista_materias_vacia"
                    android:textColor="@color/texto_secundario"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/pista_lista_materias"
                    android:textColor="@color/texto_pista"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Botón + para agregar una materia -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAgregar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:contentDescription="@string/btn_agregar_materia"
            android:src="@android:drawable/ic_input_add" />
    </FrameLayout>

    <!-- Menú inferior: pega aquí el contenido de menu_inferior.xml -->
    <include layout="@layout/menu_inferior" />
</LinearLayout>
