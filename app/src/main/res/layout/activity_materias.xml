<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla P4: lista de materias -->
<!-- FrameLayout: permite poner el botón + flotando encima de la lista -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".vista.MateriasActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="@string/titulo_materias"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Lista de materias (la llena MateriaAdapter) -->
        <ListView
            android:id="@+id/lvMaterias"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="88dp" />

        <!-- Mensaje cuando la lista está vacía (el ListView lo muestra solo) -->
        <TextView
            android:id="@+id/tvVacio"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/lista_materias_vacia"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Botón + para agregar una materia -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAgregar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/btn_agregar_materia"
        android:src="@android:drawable/ic_input_add" />
</FrameLayout>