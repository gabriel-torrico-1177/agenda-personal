<?xml version="1.0" encoding="utf-8"?>
<!-- Diseño de UNA fila de la lista de contactos: datos a la izquierda y botón ✕ a la derecha -->
<!-- blocksDescendants: el botón ✕ no "roba" el foco, así tocar la fila sigue abriendo la edición -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="blocksDescendants"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    android:paddingStart="16dp"
    android:paddingEnd="8dp">

    <!-- Nombre en negrita y teléfono debajo; ocupa todo el ancho que sobra -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTelefono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Botón ✕ para eliminar (48dp mínimo) -->
    <ImageButton
        android:id="@+id/btnEliminar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/btn_eliminar_contacto"
        android:src="@android:drawable/ic_menu_close_clear_cancel" />
</LinearLayout>