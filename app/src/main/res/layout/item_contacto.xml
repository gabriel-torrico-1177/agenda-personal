<?xml version="1.0" encoding="utf-8"?>
<!-- Diseño de UNA fila de la lista de contactos: una tarjeta con los datos a la izquierda y el botón eliminar (papelera) a la derecha -->
<!-- Raíz con padding: el ListView ignora los márgenes de la raíz de cada fila, por eso el espacio
     alrededor de la tarjeta se hace con padding (16dp a los costados y 4dp + 4dp = 8dp entre tarjetas) -->
<!-- blocksDescendants: el botón eliminar no "roba" el foco, así tocar la fila sigue abriendo la edición -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="blocksDescendants"
    android:paddingHorizontal="16dp"
    android:paddingVertical="4dp">

    <!-- Tarjeta: fondo gris oscuro con borde y esquinas de 12dp (fondo_tarjeta.xml, igual que en Inicio).
         foreground: el efecto al tocar se dibuja solo sobre la tarjeta -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fondo_tarjeta"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingVertical="10dp"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <!-- Círculo de 44dp con la inicial del nombre: fondo verde suave (circulo_inicial.xml)
             y la letra verde en negrita. La letra la pone ContactoAdapter -->
        <TextView
            android:id="@+id/tvInicial"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/circulo_inicial"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="@color/verde"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Nombre en negrita y teléfono debajo; ocupa todo el ancho que sobra -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Teléfono con el ícono pequeño de teléfono delante (drawableStart) -->
            <TextView
                android:id="@+id/tvTelefono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:drawableStart="@drawable/ic_telefono"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:textColor="@color/texto_secundario"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Botón eliminar: papelera de 22dp (ic_eliminar.xml) centrada en 48dp, sin agrandarse (scaleType center) -->
        <ImageButton
            android:id="@+id/btnEliminar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_eliminar_contacto"
            android:scaleType="center"
            android:src="@drawable/ic_eliminar" />
    </LinearLayout>
</FrameLayout>
