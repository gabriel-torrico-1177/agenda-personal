<?xml version="1.0" encoding="utf-8"?>
<!-- Diseño de UNA fila de la lista de sesiones: círculo de color, materia, horario, estado y ✕ -->
<!-- blocksDescendants: el botón ✕ no "roba" el foco, así tocar la fila sigue abriendo la edición -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="blocksDescendants"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    android:paddingStart="16dp"
    android:paddingEnd="8dp">

    <!-- Círculo con el color de la materia (el adaptador lo pinta) -->
    <View
        android:id="@+id/vColor"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp" />

    <!-- Materia en negrita y horario debajo; ocupa todo el ancho que sobra -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMateria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHorario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp" />

        <!-- Barra de avance: solo se ve cuando la sesión está "En curso" (0 a 100 %) -->
        <ProgressBar
            android:id="@+id/pbEnCurso"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progressTint="@color/en_curso"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Estado: Pendiente, Completada o Reprogramada, dentro de un borde redondeado -->
    <TextView
        android:id="@+id/tvEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/fondo_estado"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textSize="12sp" />

    <!-- Marca de Inicio: círculo con ✔ (Completada) o vacío. Oculta; el adaptador la muestra solo en Inicio,
         en el lugar del botón ✕ (que en Inicio no se usa) -->
    <ImageView
        android:id="@+id/ivMarca"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginHorizontal="12dp"
        android:visibility="gone" />

    <!-- Botón ✕ para eliminar (48dp mínimo) -->
    <ImageButton
        android:id="@+id/btnEliminar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/btn_eliminar_sesion"
        android:src="@android:drawable/ic_menu_close_clear_cancel" />
</LinearLayout>