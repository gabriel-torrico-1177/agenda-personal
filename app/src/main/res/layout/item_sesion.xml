<?xml version="1.0" encoding="utf-8"?>
<!-- Diseño de UNA fila de la lista de sesiones: círculo de color, materia, horario y estado -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <!-- Círculo con el color de la materia (el adaptador lo pinta) -->
    <View
        android:id="@+id/vColor"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp" />

    <!-- Materia en negrita y horario debajo; ocupa todo el ancho que sobra -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMateria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHorario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Estado: Pendiente, Completada o Reprogramada, dentro de un borde redondeado -->
    <TextView
        android:id="@+id/tvEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/fondo_estado"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textSize="12sp" />
</LinearLayout>