<?xml version="1.0" encoding="utf-8"?>
<!-- Diseño de UN día de la tira de la semana: letra del día, número y un punto si tiene sesiones -->
<!-- width 0dp + weight 1: los 7 días se reparten el ancho por igual -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    android:layout_weight="1"
    android:background="@drawable/fondo_dia"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:minHeight="64dp"
    android:orientation="vertical"
    android:paddingVertical="6dp">

    <!-- Letra del día: L, M, M, J, V, S, D -->
    <TextView
        android:id="@+id/tvLetra"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp" />

    <!-- Número del día del mes: 9, 10, 11... -->
    <TextView
        android:id="@+id/tvNumero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Punto: visible solo si ese día tiene sesiones -->
    <View
        android:id="@+id/vPunto"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/punto"
        android:visibility="invisible" />
</LinearLayout>