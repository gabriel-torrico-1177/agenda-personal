<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla P3: formulario para registrar una sesión de estudio -->
<!-- ScrollView: permite desplazar el formulario cuando aparece el teclado -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".vista.SesionFormActivity">

    <!-- Todos los elementos uno debajo del otro -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Título de la pantalla -->
        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/titulo_nueva_sesion"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Materia: lista desplegable (Spinner) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/etiqueta_materia"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spMateria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="48dp" />

        <!-- Fecha: no se escribe, al tocarla se abre el calendario (DatePickerDialog) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/etiqueta_fecha"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:drawableStart="@android:drawable/ic_menu_my_calendar"
            android:drawablePadding="8dp"
            android:focusable="false"
            android:importantForAutofill="no"
            android:inputType="none"
            android:minHeight="48dp" />

        <!-- Inicio y Fin, uno al lado del otro: al tocarlos se abre el reloj (TimePickerDialog) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/etiqueta_inicio"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etInicio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@android:drawable/ic_menu_recent_history"
                    android:drawablePadding="8dp"
                    android:focusable="false"
                    android:importantForAutofill="no"
                    android:inputType="none"
                    android:minHeight="48dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/etiqueta_fin"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etFin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@android:drawable/ic_menu_recent_history"
                    android:drawablePadding="8dp"
                    android:focusable="false"
                    android:importantForAutofill="no"
                    android:inputType="none"
                    android:minHeight="48dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Estado: RadioGroup = solo se puede marcar una opción. Pendiente marcado por defecto -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/etiqueta_estado"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:checkedButton="@+id/rbPendiente"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbPendiente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/estado_pendiente" />

            <RadioButton
                android:id="@+id/rbCompletada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/estado_completada" />

            <RadioButton
                android:id="@+id/rbReprogramada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/estado_reprogramada" />
        </RadioGroup>

        <!-- Notas (opcional), varias líneas -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/etiqueta_notas"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNotas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="top|start"
            android:hint="@string/pista_notas"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:minHeight="48dp"
            android:minLines="2" />

        <!-- Botones Cancelar y Guardar, uno al lado del otro y del mismo ancho -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/btn_cancelar" />

            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/btn_guardar" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>