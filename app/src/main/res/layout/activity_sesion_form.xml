<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla P3: formulario para registrar o editar una sesión de estudio.
     Cada campo va en una caja redondeada (estilo CajaCampo) con un ícono a la izquierda.
     Los id son los mismos de antes: SesionFormActivity no cambió -->
<!-- ScrollView: permite desplazar el formulario (pantallas chicas o con el teclado abierto) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".vista.SesionFormActivity">

    <!-- Todos los elementos uno debajo del otro -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Título de la pantalla ("Nueva sesión" o "Editar sesión") -->
        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/titulo_nueva_sesion"
            android:textColor="@color/texto"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- MATERIA. Un Spinner no tiene drawableStart, así que la caja es un LinearLayout
             horizontal con el ícono (ImageView) y el Spinner al lado -->
        <TextView
            style="@style/EtiquetaCampo"
            android:text="@string/etiqueta_materia" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/caja_campo"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_libro" />

            <Spinner
                android:id="@+id/spMateria"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp" />
        </LinearLayout>

        <!-- FECHA: no se escribe, al tocarla se abre el calendario (DatePickerDialog) -->
        <TextView
            style="@style/EtiquetaCampo"
            android:text="@string/etiqueta_fecha" />

        <EditText
            android:id="@+id/etFecha"
            style="@style/CajaCampo"
            android:layout_marginBottom="16dp"
            android:drawableStart="@drawable/ic_calendario"
            android:focusable="false"
            android:importantForAutofill="no"
            android:inputType="none" />

        <!-- INICIO y FIN, lado a lado en una fila: cada uno ocupa la mitad (width 0dp + weight 1).
             Al tocarlos se abre el reloj (TimePickerDialog) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/EtiquetaCampo"
                    android:text="@string/etiqueta_inicio" />

                <EditText
                    android:id="@+id/etInicio"
                    style="@style/CajaCampo"
                    android:drawableStart="@drawable/ic_reloj"
                    android:focusable="false"
                    android:importantForAutofill="no"
                    android:inputType="none" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/EtiquetaCampo"
                    android:text="@string/etiqueta_fin" />

                <EditText
                    android:id="@+id/etFin"
                    style="@style/CajaCampo"
                    android:drawableStart="@drawable/ic_reloj"
                    android:focusable="false"
                    android:importantForAutofill="no"
                    android:inputType="none" />
            </LinearLayout>
        </LinearLayout>

        <!-- ESTADO como chips: sigue siendo un RadioGroup (solo se puede elegir uno), pero en fila y
             cada RadioButton con el estilo ChipEstado (sin circulito, fondo verde si está elegido).
             Pendiente marcado por defecto -->
        <TextView
            style="@style/EtiquetaCampo"
            android:text="@string/etiqueta_estado" />

        <RadioGroup
            android:id="@+id/rgEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="-4dp"
            android:layout_marginBottom="16dp"
            android:checkedButton="@+id/rbPendiente"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbPendiente"
                style="@style/ChipEstado"
                android:text="@string/estado_pendiente" />

            <RadioButton
                android:id="@+id/rbCompletada"
                style="@style/ChipEstado"
                android:text="@string/estado_completada" />

            <RadioButton
                android:id="@+id/rbReprogramada"
                style="@style/ChipEstado"
                android:text="@string/estado_reprogramada" />
        </RadioGroup>

        <!-- NOTAS (opcional), varias líneas, en la misma caja (el borde se pone verde al escribir) -->
        <TextView
            style="@style/EtiquetaCampo"
            android:text="@string/etiqueta_notas" />

        <EditText
            android:id="@+id/etNotas"
            style="@style/CajaCampo"
            android:layout_marginBottom="24dp"
            android:gravity="top|start"
            android:hint="@string/pista_notas"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2" />

        <!-- Terminar ahora: oculto; solo se muestra al abrir una sesión que está "En curso" -->
        <Button
            android:id="@+id/btnTerminar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/en_curso"
            android:minHeight="48dp"
            android:text="@string/btn_terminar_ahora"
            android:visibility="gone" />

        <!-- Botones Cancelar (con borde) y Guardar (verde), uno al lado del otro y del mismo ancho -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelar"
                style="@style/BotonSecundario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/btn_cancelar" />

            <Button
                android:id="@+id/btnGuardar"
                style="@style/BotonPrincipal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/btn_guardar" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
