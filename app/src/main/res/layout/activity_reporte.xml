<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla P7: reporte semanal. Arriba la semana con ◀ ▶, la tarjeta de resumen, una tarjeta por materia y abajo el menú -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".vista.ReporteActivity">

    <!-- Encabezado, fila 1: flecha ← (boton_volver.xml) y título "Reporte semanal" -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp">

        <include layout="@layout/boton_volver" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/titulo_reporte"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Encabezado, fila 2: ◀ semana ▶, centrado (no entra en la misma fila que el título) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAnterior"
            style="?attr/borderlessButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/semana_anterior"
            android:minWidth="48dp"
            android:padding="0dp"
            android:text="@string/flecha_anterior" />

        <!-- "Semana del 16/11 al 22/11" -->
        <TextView
            android:id="@+id/tvSemana"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSiguiente"
            style="?attr/borderlessButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/semana_siguiente"
            android:minWidth="48dp"
            android:padding="0dp"
            android:text="@string/flecha_siguiente" />
    </LinearLayout>

    <!-- Tarjeta de resumen (reemplaza la fila "Total"): % de la semana en grande, barra y horas.
         Mismo estilo que la tarjeta de la meta (tarjeta_meta.xml) -->
    <LinearLayout
        android:id="@+id/tarjetaResumen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/fondo_tarjeta"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Título con el ícono de gráfico de barras -->
        <TextView
            style="@style/TituloTarjeta"
            android:drawableStart="@drawable/ic_grafico"
            android:text="@string/titulo_cumplimiento" />

        <!-- Porcentaje de la semana, por ejemplo "62 %" -->
        <TextView
            android:id="@+id/tvPorcentajeTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Barra de 0 a 100 (%), la misma de la meta (barra_progreso.xml) -->
        <ProgressBar
            android:id="@+id/pbTotal"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginVertical="8dp"
            android:max="100"
            android:maxHeight="8dp"
            android:minHeight="8dp"
            android:progressDrawable="@drawable/barra_progreso" />

        <!-- "5,93 h hechas de 9,5 h planificadas" -->
        <TextView
            android:id="@+id/tvHorasTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Una tarjeta por materia (item_reporte.xml, la arma ReporteAdapter).
         divider @null: sin líneas entre filas (el espacio lo da cada tarjeta);
         listSelector transparente: las tarjetas no se tocan, así no se ilumina la fila -->
    <ListView
        android:id="@+id/lvReporte"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@null"
        android:listSelector="@android:color/transparent"
        android:paddingVertical="8dp" />

    <!-- Mensaje cuando la semana no tiene sesiones (se muestra en lugar de la tarjeta y la lista) -->
    <TextView
        android:id="@+id/tvVacio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/reporte_vacio"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Menú inferior -->
    <include layout="@layout/menu_inferior" />
</LinearLayout>