<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla P5: formulario para crear una materia -->
<!-- ScrollView: permite desplazar el formulario cuando aparece el teclado -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".vista.MateriaFormActivity">

    <!-- Todos los elementos uno debajo del otro -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Título de la pantalla -->
        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/titulo_nueva_materia"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Nombre (obligatorio) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/etiqueta_nombre"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/pista_nombre_materia"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:minHeight="48dp" />

        <!-- Docente (opcional) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/etiqueta_docente"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDocente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/pista_docente"
            android:importantForAutofill="no"
            android:inputType="textPersonName|textCapWords"
            android:minHeight="48dp" />

        <!-- Color: 6 círculos de 48dp. El color de cada uno va en android:tag -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/etiqueta_color"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/color1"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/color_azul"
                android:tag="#3F51B5" />

            <View
                android:id="@+id/color2"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/color_rojo"
                android:tag="#F44336" />

            <View
                android:id="@+id/color3"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/color_verde"
                android:tag="#4CAF50" />

            <View
                android:id="@+id/color4"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/color_naranja"
                android:tag="#FF9800" />

            <View
                android:id="@+id/color5"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/color_morado"
                android:tag="#9C27B0" />

            <View
                android:id="@+id/color6"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/color_cafe"
                android:tag="#795548" />
        </LinearLayout>

        <!-- Botones Cancelar y Guardar, uno al lado del otro y del mismo ancho -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelar"
                style="@style/BotonSecundario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/btn_cancelar" />

            <Button
                android:id="@+id/btnGuardar"
                style="@style/BotonPrincipal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/btn_guardar" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>