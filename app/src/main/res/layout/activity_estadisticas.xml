<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla P6: estadísticas de esta semana. Arriba el contenido (con scroll) y abajo el menú -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".vista.EstadisticasActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Título y "Semana del 09/11 al 15/11" -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/titulo_estadisticas"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSemana"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:textSize="14sp" />

            <!-- Tarjeta de horas estudiadas: "15 h" y la comparación "↑ 25 % vs. semana anterior" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/fondo_tarjeta"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Título con el ícono de reloj, con el mismo estilo que "META SEMANAL" -->
                <TextView
                    style="@style/TituloTarjeta"
                    android:drawableStart="@drawable/ic_reloj"
                    android:text="@string/titulo_horas_estudiadas" />

                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVariacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Tarjeta de la meta (la misma de Inicio; se toca para abrir Meta semanal) -->
            <include layout="@layout/tarjeta_meta" />

            <!-- Barras por materia -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="@string/titulo_horas_por_materia"
                android:textStyle="bold" />

            <!-- Vacío: EstadisticasActivity le agrega una barra (item_barra.xml) por materia -->
            <LinearLayout
                android:id="@+id/llBarras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Mensaje cuando no hay horas completadas (se muestra en lugar de las barras) -->
            <TextView
                android:id="@+id/tvVacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/estadisticas_vacio"
                android:textSize="16sp"
                android:visibility="gone" />

            <!-- Aclaración -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/nota_completadas"
                android:textSize="12sp"
                android:textStyle="italic" />
        </LinearLayout>
    </ScrollView>

    <!-- Menú inferior -->
    <include layout="@layout/menu_inferior" />
</LinearLayout>