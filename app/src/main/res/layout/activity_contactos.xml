<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla P2: lista de contactos con buscador -->
<!-- Raíz vertical: arriba el contenido (FrameLayout) y abajo el menú inferior -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".vista.ContactosActivity">

    <!-- FrameLayout: permite poner el botón + flotando encima de la lista.
         height 0dp + weight 1: ocupa todo el alto que deja libre el menú -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Título -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/titulo_contactos"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Buscador -->
            <EditText
                android:id="@+id/etBuscar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="8dp"
                android:hint="@string/pista_buscar"
                android:importantForAutofill="no"
                android:inputType="textPersonName"
                android:minHeight="48dp" />

            <!-- Lista de contactos (la llena ContactoAdapter) -->
            <ListView
                android:id="@+id/lvContactos"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingBottom="88dp"
                android:clipToPadding="false" />

            <!-- Mensaje cuando la lista está vacía (el ListView lo muestra solo) -->
            <TextView
                android:id="@+id/tvVacio"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="16dp"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Botón + para agregar un contacto -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAgregar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:contentDescription="@string/btn_agregar_contacto"
            android:src="@android:drawable/ic_input_add" />
    </FrameLayout>

    <!-- Menú inferior: pega aquí el contenido de menu_inferior.xml -->
    <include layout="@layout/menu_inferior" />
</LinearLayout>
