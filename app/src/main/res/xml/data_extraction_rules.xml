<?xml version="1.0" encoding="utf-8"?>
<!-- Reglas de respaldo para Android 12 o más (API 31+).
     La app es "sin nube": nada se copia a Google Drive.
     Solo se permite pasar los datos a un teléfono nuevo (copia directa, sin internet). -->
<data-extraction-rules>

    <!-- Respaldo en la nube (Google Drive): se excluye todo -->
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>

    <!-- Transferencia directa a un teléfono nuevo (cable o wifi, sin nube):
         la base de datos agenda.db y el archivo "perfil" con el nombre -->
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>

</data-extraction-rules>
