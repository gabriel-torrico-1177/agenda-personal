    <!-- Contador debajo del título. plurals: Android elige "one" o "other" según el número
         (1 → "1 contacto", 0 o 2 → "2 contactos"); %d se reemplaza por el número.
         "many" lo usan los Android nuevos en español para números como 1 000 000: igual que "other" -->
    <plurals name="contador_contactos">
        <item quantity="one">%d contacto</item>
        <item quantity="many">%d contactos</item>
        <item quantity="other">%d contactos</item>
    </plurals>

