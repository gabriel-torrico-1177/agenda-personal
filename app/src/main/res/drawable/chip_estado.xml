<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de un chip de estado (cada RadioButton de Pendiente, Completada y Reprogramada).
     state_checked="true" = el RadioButton elegido: relleno verde.
     El último item (sin estado) = los no elegidos: gris muy oscuro con borde -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/verde" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/tarjeta" />
            <stroke
                android:width="1dp"
                android:color="@color/borde" />
        </shape>
    </item>
</selector>
