<?xml version="1.0" encoding="utf-8"?>
<!-- Dibujo de la barra de la meta (ProgressBar): dos capas con esquinas redondeadas.
     @android:id/background = la pista gris; @android:id/progress = la parte verde.
     scale estira la parte verde según el progreso (0 a 100 %) sin perder las esquinas redondeadas -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="@color/tarjeta_alta" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <corners android:radius="4dp" />
                <solid android:color="@color/verde" />
            </shape>
        </scale>
    </item>
</layer-list>
