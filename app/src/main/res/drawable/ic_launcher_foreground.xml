<?xml version="1.0" encoding="utf-8"?>
<!-- Capa del frente del ícono: la Catedral de Santa Cruz (verde) y, detrás, el Cristo Redentor (verde oscuro).
     Lienzo de 108 x 108 (viewport). Zona segura: un círculo de radio 33 con centro en (54, 54);
     todo el dibujo queda a 31 o menos del centro, así ninguna forma de ícono lo corta.
     Coordenadas: x crece hacia la derecha, y crece hacia ABAJO (y = 0 es el borde de arriba).
     Comandos de pathData: M = mover a, L = línea hasta, A = arco, Z = cerrar la figura -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. Cristo Redentor (se dibuja primero: lo que se dibuja después queda delante) -->
    <!-- Cabeza: círculo de radio 2,5 con centro en (54, 27), hecho con dos medios arcos -->
    <path
        android:fillColor="@color/verde_oscuro"
        android:pathData="M51.5,27 A2.5,2.5 0 1,0 56.5,27 A2.5,2.5 0 1,0 51.5,27 Z" />
    <!-- Brazos abiertos (de x 43 a 65): más gruesos en los hombros (y 30.2 a 33) y un poco levantados
         en las manos (y 29 a 31). Desde los hombros baja la túnica, que se ensancha hacia los pies (y 42) -->
    <path
        android:fillColor="@color/verde_oscuro"
        android:pathData="M43,29 L51.4,30.2 L56.6,30.2 L65,29 L65,31 L56.6,33 L57.5,42 L50.5,42 L51.4,33 L43,31 Z" />
    <!-- Pedestal: una base ancha (y 42 a 44) y una columna que baja y se esconde detrás de la cúpula -->
    <path
        android:fillColor="@color/verde_oscuro"
        android:pathData="M49,42 L59,42 L59,44 L57.5,44 L57.5,58 L50.5,58 L50.5,44 L49,44 Z" />

    <!-- 2. Catedral. evenOdd: las figuras dibujadas DENTRO del contorno (puerta y ventanas)
         quedan como huecos, y por ellos se ve el fondo negro -->
    <path
        android:fillColor="@color/verde"
        android:fillType="evenOdd"
        android:pathData="M32,76 L32,48 L36.5,38 L41,48 L41,58 L46,58 A8,8 0 0,1 62,58 L67,58 L67,48 L71.5,38 L76,48 L76,76 Z M50,76 L50,66 A4,4 0 0,1 58,66 L58,76 Z M35,58 L35,52 A1.5,1.5 0 0,1 38,52 L38,58 Z M70,58 L70,52 A1.5,1.5 0 0,1 73,52 L73,58 Z" />
    <!-- Contorno (se recorre en el sentido del reloj desde abajo a la izquierda):
         torre izquierda: sube por x 32 hasta y 48, punta del techo en (36.5, 38), baja a (41, 48);
         cuerpo central: baja a y 58 (techo plano), y en (46, 58) empieza la cúpula: medio círculo
         de radio 8 hasta (62, 58) que sube hasta y 50; torre derecha: igual que la izquierda pero
         de x 67 a 76; termina abajo en (76, 76) y Z cierra por el suelo (y 76).
         Huecos: puerta en arco (x 50 a 58, arco de radio 4 que sube hasta y 62) y una ventana
         en arco en cada torre (3 de ancho, arco de radio 1,5) -->
</vector>
