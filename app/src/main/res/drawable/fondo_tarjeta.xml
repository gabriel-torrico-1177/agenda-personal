<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de una tarjeta (por ejemplo, la del progreso de la meta): gris muy oscuro con borde y esquinas redondeadas -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <solid android:color="@color/tarjeta" />
    <stroke
        android:width="1dp"
        android:color="@color/borde" />
</shape>
