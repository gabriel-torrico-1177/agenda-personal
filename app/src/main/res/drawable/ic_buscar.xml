<?xml version="1.0" encoding="utf-8"?>
<!-- Ícono de lupa (buscador de Contactos): un círculo y el mango. Mismo estilo de líneas que ic_persona.
     Lienzo de 24 x 24 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="20dp"
    android:height="20dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Vidrio: círculo de radio 7 con centro en (11, 11) -->
    <path
        android:pathData="M4,11 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0"
        android:strokeWidth="2"
        android:strokeColor="@color/texto_secundario" />
    <!-- Mango: línea en diagonal hacia abajo a la derecha -->
    <path
        android:pathData="M16,16 L21,21"
        android:strokeLineCap="round"
        android:strokeWidth="2"
        android:strokeColor="@color/texto_secundario" />
</vector>
