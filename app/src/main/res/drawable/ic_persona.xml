<?xml version="1.0" encoding="utf-8"?>
<!-- Ícono de persona (panel Más: Contactos): cabeza redonda y hombros. Lienzo de 24 x 24 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="20dp"
    android:height="20dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Cabeza: círculo de radio 4 con centro en (12, 8) -->
    <path
        android:pathData="M8,8 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0"
        android:strokeWidth="2"
        android:strokeColor="@color/verde" />
    <!-- Hombros: un arco que va de (4, 21) a (20, 21) pasando por arriba -->
    <path
        android:pathData="M4,21 a8,7 0 0,1 16,0"
        android:strokeLineCap="round"
        android:strokeWidth="2"
        android:strokeColor="@color/verde" />
</vector>
