<?xml version="1.0" encoding="utf-8"?>
<!-- Flecha ← para volver: una línea horizontal y una punta. Lienzo de 24 x 24, en el color del texto -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Línea de (19, 12) a (5, 12) y la punta: de (11, 6) a (5, 12) y a (11, 18) -->
    <path
        android:pathData="M19,12 L5,12 M11,6 L5,12 L11,18"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.2"
        android:strokeColor="@color/texto" />
</vector>
