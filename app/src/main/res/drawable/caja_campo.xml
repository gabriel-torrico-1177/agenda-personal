<?xml version="1.0" encoding="utf-8"?>
<!-- Caja de un campo del formulario: gris muy oscuro, esquinas redondeadas y borde.
     selector = elige el dibujo según el estado: si el campo tiene el foco (por ejemplo, Notas
     mientras escribes) el borde es verde; si no, gris oscuro. Se revisa de arriba hacia abajo -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/tarjeta" />
            <stroke
                android:width="2dp"
                android:color="@color/verde" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/tarjeta" />
            <stroke
                android:width="1dp"
                android:color="@color/borde" />
        </shape>
    </item>
</selector>
