<?xml version="1.0" encoding="utf-8"?>
<!-- Ícono de diana (meta): dos anillos (círculos solo con borde) y un punto relleno al centro.
     Lienzo de 24 x 24. Cada círculo se dibuja con dos medios arcos (a = arco relativo) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="20dp"
    android:height="20dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Anillo de afuera (radio 9) y anillo del medio (radio 5): strokeColor = solo el borde -->
    <path
        android:pathData="M3,12 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0"
        android:strokeWidth="2"
        android:strokeColor="@color/verde" />
    <path
        android:pathData="M7,12 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0"
        android:strokeWidth="2"
        android:strokeColor="@color/verde" />
    <!-- Centro (radio 1,8): fillColor = relleno -->
    <path
        android:fillColor="@color/verde"
        android:pathData="M10.2,12 a1.8,1.8 0 1,0 3.6,0 a1.8,1.8 0 1,0 -3.6,0" />
</vector>
