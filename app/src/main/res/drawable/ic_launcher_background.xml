<?xml version="1.0" encoding="utf-8"?>
<!-- Capa de fondo del ícono: un cuadrado de 108 x 108 relleno de casi negro (#0E0E0E).
     El sistema lo recorta con la forma que use el teléfono (círculo, gota, cuadrado redondeado...) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- M0,0 = empezar arriba a la izquierda; h108 = 108 a la derecha; v108 = 108 abajo;
         h-108 = 108 a la izquierda; z = cerrar -->
    <path
        android:fillColor="@color/fondo"
        android:pathData="M0,0 h108 v108 h-108 z" />
</vector>
