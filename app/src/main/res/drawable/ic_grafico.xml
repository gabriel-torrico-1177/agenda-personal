<?xml version="1.0" encoding="utf-8"?>
<!-- Ícono de gráfico de barras (menú: Estadísticas): tres barras de distinta altura sobre una base.
     Lienzo de 24 x 24. Cada barra es una línea gruesa con puntas redondeadas -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="20dp"
    android:height="20dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Barras: baja (x 6), alta (x 12) y mediana (x 18) -->
    <path
        android:pathData="M6,18 L6,13 M12,18 L12,5 M18,18 L18,9"
        android:strokeLineCap="round"
        android:strokeWidth="3"
        android:strokeColor="@color/verde" />
    <!-- Base -->
    <path
        android:pathData="M3,21 L21,21"
        android:strokeLineCap="round"
        android:strokeWidth="2"
        android:strokeColor="@color/verde" />
</vector>
