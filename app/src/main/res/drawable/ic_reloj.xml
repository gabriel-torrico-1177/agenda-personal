<?xml version="1.0" encoding="utf-8"?>
<!-- Ícono de reloj (próxima sesión): un círculo con borde y dos agujas. Lienzo de 24 x 24 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="20dp"
    android:height="20dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Esfera: círculo de radio 9 con centro en (12, 12) -->
    <path
        android:pathData="M3,12 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0"
        android:strokeWidth="2"
        android:strokeColor="@color/verde" />
    <!-- Agujas: de las 12 baja al centro y sale hacia las 4. round = puntas redondeadas -->
    <path
        android:pathData="M12,7 L12,12 L15.5,14"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2"
        android:strokeColor="@color/verde" />
</vector>
